# ==========================================
# AI Coaching Institute Performance & Fee Intelligence
# Environment Configuration Template
# ==========================================

# Server & Runtime Environment
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000/api/v1
FRONTEND_URL=http://localhost:5173

# Database (Supabase PostgreSQL / Prisma)
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[YOUR_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres:[YOUR_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres?sslmode=require

# Supabase Auth & Storage Configuration
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Google Gemini AI Integration (Official @google/genai SDK)
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=your_google_gemini_api_key_here

# Razorpay Payment Gateway (INR)
# Get your Test Keys from Razorpay Dashboard: Settings > API Keys
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Optional: Institute System Admin Setup
ADMIN_DEFAULT_EMAIL=admin@edutrack.ai
ADMIN_DEFAULT_PASSWORD=ChangeMeSecure123!
